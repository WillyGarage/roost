<Window x:Class="Vdx.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vdx — Help"
        Width="820" Height="720"
        MinWidth="560" MinHeight="400"
        Background="#FF1E1F22"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush"   Color="#FFE9E9EA"/>
        <SolidColorBrush x:Key="DimBrush"    Color="#FF95979C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7FB2E8"/>
        <SolidColorBrush x:Key="EdgeBrush"   Color="#FF3A3D41"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FF2C2E33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Vdx" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,2,0,0"
                       Foreground="{StaticResource DimBrush}"/>
        </StackPanel>

        <!-- Content is built in code so the hotkeys, paths and status shown are the live
             ones, and so the config reference cannot drift from Config.Reference. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Open config file" Click="OnOpenConfig"/>
            <Button Content="Open log folder" Click="OnOpenLogs"/>
            <Button Content="Copy diagnostics" Click="OnCopyDiagnostics"/>
            <Button Content="Close" Click="OnClose" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
