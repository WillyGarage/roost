<Window x:Class="Vdx.App.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vdx"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!-- Transient overlay, so it commits to one dark treatment rather than following
         the system theme. It is on screen for a second at a time. -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush"     Color="#FF1E1F22"/>
        <SolidColorBrush x:Key="EdgeBrush"      Color="#FF3A3D41"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#FFE9E9EA"/>
        <SolidColorBrush x:Key="DimBrush"       Color="#FF95979C"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#FF4C8DD9"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#FF2C4F79"/>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="#FF2A2C30"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="#FF000000"/>
        </Border.Effect>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- What is about to happen, including the window being moved. -->
            <TextBlock x:Name="HeaderText"
                       Grid.Row="0"
                       Margin="12,8,12,2"
                       FontSize="12"
                       Foreground="{StaticResource DimBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBox x:Name="Query"
                     Grid.Row="1"
                     Margin="10,4,10,6"
                     Padding="8,7"
                     FontSize="17"
                     BorderThickness="0"
                     Background="#FF17181A"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     TextChanged="OnQueryChanged"/>

            <ListBox x:Name="Items"
                     Grid.Row="2"
                     MaxHeight="380"
                     Margin="6,0,6,4"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ItemContainerStyle="{StaticResource RowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Display}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Badge}"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DimBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="FooterText"
                       Grid.Row="3"
                       Margin="12,2,12,8"
                       FontSize="11"
                       Foreground="{StaticResource DimBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
